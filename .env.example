# 到 https://console.anthropic.com/ 申請 API 金鑰後，複製這個檔案成 .env，並貼上你的金鑰
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxxxxxx

# 想換模型可以改這裡，預設用 Sonnet 5（品質較好）
# 想省費用可以改成 claude-haiku-4-5-20251001
ANTHROPIC_MODEL=claude-sonnet-5

# 本機伺服器要用的連接埠，不確定就不要改
PORT=3000

# 通關密碼：設定後，學生要先輸入這組密碼才能使用（適合補習班/教室部署）
# 留空＝不需要密碼，任何人拿到網址都能直接用（適合自己在家測試）
ACCESS_CODE=
